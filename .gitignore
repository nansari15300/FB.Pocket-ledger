# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# static build temp
.build-static-bak/

# Serwist PWA generated service worker(s)
/public/sw*.js
/public/sw*.js.map
/public/swe-worker*
/electron/node_modules/
/electron/dist/

# Capacitor native (uncomment if you don't commit android/ios)
# /android/
# /ios/

# Android release signing (create android/keystore.properties locally; never commit secrets)
android/keystore.properties
*.jks
*.keystore

# Staged website installers (date folders + latest.json)
/releases/**
!/releases/README.md

# misc
.data/
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.build-logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local junction to C:\Balgram\PocketLedger-Server (not part of this repo)
/PocketLedger-Server/

# Two-PC sync: generated output, native build artifacts, secrets (added 2026-11-02)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.apk
*.aab
*.exe
google-services.json
pl-*-token*.json
*access-tokens*.json
*.key
